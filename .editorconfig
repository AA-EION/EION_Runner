# Runner Forge — editor defaults. Keep diffs boring.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{cs,csproj,sln,props,targets}]
indent_size = 4
# Visual Studio and MSBuild are happiest with CRLF in the Windows solution.
end_of_line = crlf

[*.{xaml,xml,resx}]
indent_size = 2
end_of_line = crlf

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.swift]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[*.{yml,yaml,tmpl,json,toml,hcl}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
