<Window x:Class="RunnerForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner Forge" Height="760" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The eight pages, in the order the setup journey runs. The macOS app
             presents the same eight in the same order, so knowing one app means
             knowing the other. -->
        <DockPanel Grid.Column="0" Background="#F1F3F4">
            <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10">
                <TextBlock Text="Runner Forge" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Foreground="#666" FontSize="11"/>
            </StackPanel>

            <ListBox x:Name="NavigationList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnNavigationChanged" Margin="6,0,6,10">
                <ListBoxItem Content="Preflight"/>
                <ListBoxItem Content="Credentials"/>
                <ListBoxItem Content="Targets"/>
                <ListBoxItem Content="Runners"/>
                <ListBoxItem Content="Signing"/>
                <ListBoxItem Content="Export"/>
                <ListBoxItem Content="Logs"/>
                <ListBoxItem Content="Cleanup"/>
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="PageHost" Grid.Column="1"/>
    </Grid>
</Window>
