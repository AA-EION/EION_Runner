<UserControl x:Class="RunnerForge.Views.CredentialsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="820">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Credentials" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#666"
                   Text="Secrets go into Windows Credential Manager and are never written to forge.json, never to a file, never into an image layer. Values are write-only here: nothing reads one back to display it."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Test GitHub App" Command="{Binding TestGitHubCommand}" Padding="12,4"/>
            <TextBlock Text="{Binding TestResult}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- VirtualizingPanel.IsVirtualizing="False" and a FIXED Width on the
             wrapping TextBlock are both load-bearing. A wrapping TextBlock whose
             width is only bounded by MaxWidth has a height that depends on the
             width it is given, and inside a virtualizing panel that feeds back:
             the panel sizes the viewport, the wrap changes the height, the
             viewport changes, InitializeViewport calls UpdateLayout, and the
             measure pass re-enters itself until the stack overflows
             (0xC00000FD). These lists hold tens of rows, so virtualization buys
             nothing and removing it removes the mechanism. See TROUBLESHOOTING #20. -->
        <ListView x:Name="FieldsList" ItemsSource="{Binding Fields}"
                  VirtualizingPanel.IsVirtualizing="False">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Secret" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="What it is" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Width="320"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="State" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
