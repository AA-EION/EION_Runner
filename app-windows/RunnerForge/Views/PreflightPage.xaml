<UserControl x:Class="RunnerForge.Views.PreflightPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="820">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Preflight" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Re-check" Command="{Binding RunChecksCommand}" Margin="16,0,0,0" Padding="12,4"/>
            <TextBlock Text="{Binding Summary}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#666"
                   Text="What is missing on this machine, and what can be fixed from here. A Fail blocks the runner classes it names; a hard block has no workaround and says so."/>

        <!-- VirtualizingPanel.IsVirtualizing="False" and a FIXED Width on the
             wrapping TextBlock are both load-bearing. A wrapping TextBlock whose
             width is only bounded by MaxWidth has a height that depends on the
             width it is given, and inside a virtualizing panel that feeds back:
             the panel sizes the viewport, the wrap changes the height, the
             viewport changes, InitializeViewport calls UpdateLayout, and the
             measure pass re-enters itself until the stack overflows
             (0xC00000FD). These lists hold tens of rows, so virtualization buys
             nothing and removing it removes the mechanism. See TROUBLESHOOTING #20. -->
        <ListView ItemsSource="{Binding Checks}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="False">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Check" Width="230" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Detail" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Width="370"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Fix" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Fix" Padding="8,2"
                                        Visibility="{Binding AutoFixable, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
