# ---------------------------------------------------------------------------
# Runner Forge — compose environment. Copy to `.env` and adjust.
#
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ONE.
#
# Credentials — the GitHub App private key, the JIT config, PACE and Apple and
# Azure credentials — live in the OS keystore and are injected at start time
# through a separate, RAM-backed env file whose path is given by
# WIN_BUILD_ENV_FILE / LINUX_UTIL_ENV_FILE below. That file is overwritten with
# random bytes and deleted as soon as the container reports started; it is never
# this file, and it is never committed.
#
# `.env` is in .gitignore. `.env.example` is the only one that is tracked.
# ---------------------------------------------------------------------------

# --- image tags -------------------------------------------------------------
# These MUST match [windows_image].tag and [linux_image].tag in versions.toml.
# The GUI writes them from versions.toml so the two cannot drift; set them by
# hand only when running compose from a terminal.
WIN_BUILD_TAG=1.0.0
LINUX_UTIL_TAG=1.0.0

# --- replica counts ---------------------------------------------------------
# Defaults per runner class. Range 1..4; the GUI enforces the same bounds.
WIN_BUILD_REPLICAS=2
LINUX_UTIL_REPLICAS=1

# --- resource limits --------------------------------------------------------
# A plugin build is happy to use every core it can see. Capping keeps the host
# usable while runners are active.
WIN_BUILD_CPUS=4
WIN_BUILD_MEMORY=8g
LINUX_UTIL_CPUS=4
LINUX_UTIL_MEMORY=8g

# --- credential injection ---------------------------------------------------
# Path to the RAM-backed env file holding RUNNER_JITCONFIG for this class.
#
#   Windows : a file under %TEMP% on a memory-backed path, written and shredded
#             by RunnerSupervisor
#   Linux   : a file under /dev/shm, e.g. /dev/shm/runnerforge/linux-util.env
#
# The file is created immediately before `docker run` and destroyed immediately
# after the container reports started. It holds exactly one line:
#
#   RUNNER_JITCONFIG=<single-use base64 blob>
#
# Never point these at a file you intend to keep.
WIN_BUILD_ENV_FILE=C:\Users\you\AppData\Local\Temp\runnerforge\win-build.env
LINUX_UTIL_ENV_FILE=/dev/shm/runnerforge/linux-util.env
